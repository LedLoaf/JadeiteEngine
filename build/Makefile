src/utilities/utilities.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\jadeite.dir\build.make CMakeFiles/jadeite.dir/src/utilities/utilities.cpp.s
.PHONY : src/utilities/utilities.cpp.s

